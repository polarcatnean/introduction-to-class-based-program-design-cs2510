// Represents an individual tile
class Tile {
  // The number on the tile (1-15).  Use 0 to represent the hole
  int value;
  Const c = new Const();
  
  Tile(int value) {
    this.value = value;
  }

  // Draws this tile onto the background at the specified logical coordinates
  // there are 4 rows of 4 tiles 
  WorldImage drawAt(int col, int row, WorldImage background) { 
    // TODO
    // for col 1, row 1, c.tileSize, this.value as text
    WorldImage cell = // new RectangleImage(c.tileSize, c.tileSize, OutlineMode.OUTLINE, Color.BLACK)
        new OverlayImage(
            new TextImage(Integer.toString(this.value), c.fontSize, c.style, c.fontColor),
            new RectangleImage(c.tileSize, c.tileSize, OutlineMode.OUTLINE, Color.BLACK)
              )
        .movePinhole(c.tileSize / 2, c.tileSize / 2);  // pinhole at Lower Right corner
    
    WorldImage cellWithPinHole = new VisiblePinholeImage(cell, Color.RED);
    
    return new OverlayOffsetAlign(AlignModeX.LEFT, AlignModeY.TOP,
                                    cellWithPinHole,
                                    - col * c.tileSize, - row * c.tileSize,
                                    background);
  }
}
 
