package lecture31dijkstra;

import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

import tester.Tester;

class Vertex {
  String name;
  List<Edge> outEdges; // edges from this node
  
  Vertex(List<Edge> outEdges, String name) {
    this.name = name;
    this.outEdges = outEdges;  
  }
  
  @Override
  public String toString() {
    return "{" + name + "}";
  }
  
  boolean hasPathTo(Vertex dest) {
    return this.hasPathToHelper(dest, new ArrayList<Vertex>());
  }

  private boolean hasPathToHelper(Vertex dest, ArrayList<Vertex> visited) {
    for (Edge e : this.outEdges) {
      // check for cycles
      if (!visited.contains(e.to)) {
        visited.add(e.to);
        
        if (e.to == dest || e.to.hasPathToHelper(dest, visited)) {
          return true;
        }
      }
    }
    return false;
  }
}

class Edge {
  Vertex from;
  Vertex to;
  int weight;
  
  Edge(Vertex from, Vertex to, int weight) {
    this.from = from;
    this.to = to;
    this.weight = weight;
  }
  
  @Override
  public String toString() {
    return "[" + from + " -> " + to + ": " + weight + "]";
  }
}

class Graph {
  List<Vertex> allVertices;
  
  Graph(List<Vertex> allVertices) {
    this.allVertices = allVertices;
  }
  
  // METHODS:
  // computes the list of vertices that reach the given vertex
  List<Vertex> inEdges(Vertex v) {
    List<Vertex> vertices = new ArrayList<>();
    
    for (Vertex vertex : allVertices) {
      for (Edge outEdge : vertex.outEdges) {
        if (outEdge.to.equals(v)) {
          vertices.add(vertex);
          break;
        }
      }
    }
    return vertices;
  }
  
  boolean hasPathBetween(Vertex from, Vertex to) {
    Deque<Vertex> visited = new Deque<Vertex>();
    Deque<Vertex> worklist = new Deque<Vertex>();
    
    // initialise the worklist by adding the first item
    worklist.addAtHead(from);
    
    while(!worklist.isEmpty()) {
      Vertex vertex = worklist.removeFromHead();
      if (vertex.equals(to)) {
        return true;
      }
      else if (visited.contains(vertex)) {
        // do nothing
      }
      else {
        for (Edge outEdge : vertex.outEdges) {
          worklist.addAtHead(outEdge.to);
        }
        visited.addAtHead(vertex);
      }
    }
    return false;
  }
  
  // Returns the path from one vertex to another, or null if there is no such path
  List<Vertex> findCheapestPath(Vertex from, Vertex to) {
    List<Vertex> visited = new ArrayList<Vertex>();
    PriorityQueue<Vertex> worklist = new PriorityQueue<Vertex>();
    
    // Initialise the worklist with the from vertex
    worklist.add(from, 0);
    
    while (!worklist.isEmpty()) {
      WeightedItem<Vertex> currentItem = worklist.remove();
      Vertex vertex = currentItem.data;
      int weightSoFar = currentItem.weight;
      
      if (vertex.equals(to)) {
        visited.add(vertex);
        return visited;  // success!
      }
      else if (visited.contains(vertex)) {
        // do nothing
      }
      else {
        // add all the current neighbours to the worklist for further processing
        for (Edge e : vertex.outEdges) {
          worklist.add(e.to, e.weight + weightSoFar);
        }
        // add vertex to visited
        visited.add(vertex);
      }
    }
    // We haven't found the to vertex, and there are no more to try
    return new ArrayList<Vertex>();
  }
}


class ExampleGraphs {
  
  private Graph createTestGraph() {
    Vertex a = new Vertex(new ArrayList<>(), "A");
    Vertex b = new Vertex(new ArrayList<>(), "B");
    Vertex c = new Vertex(new ArrayList<>(), "C");
    Vertex d = new Vertex(new ArrayList<>(), "D");
    
    // Create edges
    a.outEdges.add(new Edge(a, b, 1));
    a.outEdges.add(new Edge(a, c, 4));
    b.outEdges.add(new Edge(b, c, 2));
    b.outEdges.add(new Edge(b, d, 5));
    c.outEdges.add(new Edge(c, d, 1));
    
    return new Graph(new ArrayList<Vertex>(Arrays.asList(a, b, c, d)));
  }
  
  // A -> B
  void testDirectPath(Tester t) {
    Graph g = createTestGraph();
    Vertex a = g.allVertices.get(0); // A
    Vertex b = g.allVertices.get(1); // B

    t.checkExpect(g.findCheapestPath(a, b), List.of(a, b));
  }
  
  // A -> D
  void testMultiHopPath(Tester t) {
    Graph g = createTestGraph();
    Vertex a = g.allVertices.get(0); // A
    Vertex b = g.allVertices.get(1); // B
    Vertex c = g.allVertices.get(2); // C
    Vertex d = g.allVertices.get(3); // D
    
    // Should take A->B->C->D(cost 4) instead of A->B->D(cost 6) or A->C->D(5)
    t.checkExpect(g.findCheapestPath(a, d), List.of(a, b, c, d));
  }
  
  void testSameSourceAndTarget(Tester t) {
    Graph g = createTestGraph();
    Vertex a = g.allVertices.get(0); // A

    t.checkExpect(g.findCheapestPath(a, a), List.of(a));
  }
  
  void testUnreachableNode(Tester t) {
    Graph g = createTestGraph();
    Vertex a = g.allVertices.get(0); // A
    
    // Create isolated vertex
    Vertex isolated = new Vertex(new ArrayList<>(), "Isolated");
    g.allVertices.add(isolated);
    
    List<Vertex> path = g.findCheapestPath(a, isolated);
    t.checkExpect(path.isEmpty(), true);
  }
  
  void testEqualCostPaths(Tester t) {
    Vertex x = new Vertex(new ArrayList<>(), "X");
    Vertex y = new Vertex(new ArrayList<>(), "Y");
    Vertex z = new Vertex(new ArrayList<>(), "Z");
    
    // X->Y->Z (cost 1+1 = 2)
    // X->Z (cost 2)
    x.outEdges.add(new Edge(x, y, 1));
    x.outEdges.add(new Edge(x, z, 2));
    y.outEdges.add(new Edge(y, z, 1));
    
    Graph g = new Graph(List.of(x, y, z));
    
    // Both paths have same cost, implementation can choose either
    List<List<Vertex>> expected = new ArrayList<>(Arrays.asList(List.of(x, z), List.of(x, y, z)));
    t.checkExpect(expected.contains(g.findCheapestPath(x, z)), true);
  }
  
}
