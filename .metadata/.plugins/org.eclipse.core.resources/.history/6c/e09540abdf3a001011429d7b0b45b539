  void testDijkstraUpheap(Tester t) {
    Vertex a = new Vertex(new ArrayList<>(), "A");
    Vertex b = new Vertex(new ArrayList<>(), "B");
    Vertex c = new Vertex(new ArrayList<>(), "C");
    
    a.outEdges.add(new Edge(a, b, 5));
    a.outEdges.add(new Edge(a, c, 10));
    b.outEdges.add(new Edge(b, c, 2));
    
    Graph g = new Graph(List.of(a, b, c));
    
    System.out.println("Normal " + g.findCheapestPath(a, c));
    System.out.println("Dijkstra " + g.findDijkstraPath(a, c) + " Expected A->B->C");
    System.out.println("Generic cheapest " + g.findPathCheapest(a, c) + " Expected A->B->C");
  }
  
  void testGenericFindPath(Tester t) {
    Vertex A = new Vertex(new ArrayList<>(), "A");
    Vertex B = new Vertex(new ArrayList<>(), "B");
    Vertex C = new Vertex(new ArrayList<>(), "C");
    Vertex D = new Vertex(new ArrayList<>(), "D");
    Vertex E = new Vertex(new ArrayList<>(), "E");
    Vertex F = new Vertex(new ArrayList<>(), "F");
    Vertex G = new Vertex(new ArrayList<>(), "G");

    A.outEdges.add(new Edge(A, B, 1));
    A.outEdges.add(new Edge(A, C, 1));
    
    B.outEdges.add(new Edge(B, G, 10));
    
    C.outEdges.add(new Edge(C, D, 1));
    D.outEdges.add(new Edge(D, E, 1));
    E.outEdges.add(new Edge(E, F, 1));
    F.outEdges.add(new Edge(F, G, 1));
        
    Graph g = new Graph(List.of(A, B, C, D, E, F, G));
    
    System.out.println("-- Test Generic --");
    System.out.println("BFS" + g.findPathBFS(A, G) + " Expected A → B → G");
    System.out.println("DFS" + g.findPathDFS(A, G) + " Expected A → C → D → E → F → G");
    System.out.println("Dijkstra" + g.findPathCheapest(A, G) + " Expected A → B → E → F → G");
  }
}
