// Represents a single square of the game area
class Cell {
  // In logical coordinates (grid indices), with the origin at the top-left corner of the screen
  int x, y;      // [0, BOARD_SIZE]
  Color color;   // random 6 colour
  boolean flooded;
  // the four adjacent cells to this one
  Cell left;    
  Cell top;     
  Cell right;   
  Cell bottom;  
  
  Cell(int x, int y) {
    this.x = x;
    this.y = y;
    this.color = FloodItWorld.COLORS.get(new Random().nextInt(FloodItWorld.COLORS.size()));
    this.flooded = false; 
    this.left = null;
    this.top = null;
    this.right = null;
    this.bottom = null;
  }
  
  // EFFECT: set pointers to the four adjacent neighbour cells, given a board and this cell's index
  void setAdjacents(ArrayList<Cell> board, int index) {
    int board_size = FloodItWorld.BOARD_SIZE;
    
    // Left neighbor (if not in the first column)
    if (x > 0) {
      this.left = board.get(index - 1);
    }
    
    // Right neighbor (if not in the last column)
    if (x < board_size - 1) {
      this.top = board.get(index + 1);
    }
    
    // Top neighbor (if not in the first row)
    if (y > 0) {
      this.right = board.get(index - board_size);
    }
    
    // Bottom neighbor (if not in the last row)
    if (y < board_size - 1) {
      this.bottom = board.get(index + board_size);
    }
    
  }
  
  WorldImage drawCell() {
    int cell_size = FloodItWorld.CELL_SIZE;

    int offsetX = this.x * cell_size + cell_size / 2;
    int offsetY = this.y * cell_size + cell_size / 2;
    
    WorldImage cellImg = new RectangleImage(cell_size, cell_size, OutlineMode.SOLID, this.color)
                            .movePinholeTo(new Posn(-offsetX, -offsetY));  // move pinhole to absolute position
    
    return cellImg;
  }
  
}


class FloodItWorld extends World {
  // All the cells of the game
  ArrayList<Cell> board;
  Random random = new Random();
  
  // Defines an int constant (size configurable)
   static int BOARD_SIZE = 10;  // 14 cells
   static int CELL_SIZE = 30;   // 20 px
   static ArrayList<Color> COLORS = new ArrayList<Color>(Arrays.asList(
                                    Color.RED, Color.BLUE, Color.CYAN, Color.GREEN, Color.ORANGE, Color.YELLOW));
   static int STEPS_ALLOWED = 25;
  
  // constructor
  FloodItWorld() {
    this.createNewBoard();    
  }
  
  // EFFECT: set this game's board to a new board
  void createNewBoard() {
    this.board = new ArrayList<Cell>(BOARD_SIZE * BOARD_SIZE);
    
    // create cells
    fillBoard();
    
    // link neighbours
    linkNeighbourCells();
    
    // Set the top-left cell (0,0) as initially flooded
    board.get(0).flooded = true;
  }
  
  // EFFECT: Fill this game's board with coloured cells
  void fillBoard() {
    for (int y = 0; y < BOARD_SIZE; y++) {
      for (int x = 0; x < BOARD_SIZE; x++) {
        Cell cell = new Cell(x, y);
        this.board.add(cell);
      }
    }
  }
  
  // EFFECT: Modify each cell in the board by setting its four adjacent cells
  void linkNeighbourCells() {
    for (int i = 0; i < board.size(); i++) {
      board.get(i).setAdjacents(board, i);
    }
  }

  public void launch() {
    int screenWidth = BOARD_SIZE * CELL_SIZE;
    int screenHeight = BOARD_SIZE * CELL_SIZE;
    super.bigBang(screenWidth, screenHeight);
  }

  @Override
  public WorldScene makeScene() {
    WorldScene scene = this.getEmptyScene();
    WorldImage boardImg = this.drawBoard(this.board);

    scene.placeImageXY(boardImg, 0, 0); // align top left corner of the board at the origin of the scene

    return scene;
  }
  
  private WorldImage drawBoard(ArrayList<Cell> board) {
    WorldImage canvas = new RectangleImage(
        BOARD_SIZE * CELL_SIZE,
        BOARD_SIZE * CELL_SIZE,
        OutlineMode.SOLID,
        Color.LIGHT_GRAY  
    ).movePinhole(-BOARD_SIZE * CELL_SIZE/2, -BOARD_SIZE * CELL_SIZE/2);
    // WorldImage canvas = new EmptyImage();
    
    for (Cell cell : board) {
      canvas = new OverlayImage(cell.drawCell(), canvas);
    }  
    return canvas;
  }
  
  public void onKeyEvent(String key) {
    // reset the game and create a new board
    if (key.equals("r")) {
      this.createNewBoard();
    }
  }
  
  public void onMouseClicked(Posn pos) {
    // convert mouse position to cell position (x, y)
    int posX = pos.x;
    int posY = pos.y;
  }
}


class FloodItExamples {
