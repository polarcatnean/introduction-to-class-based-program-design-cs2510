package lecture29heappriorityqueue;

import java.util.ArrayList;
import java.util.Arrays;

import tester.Tester;

class Heap {
  ArrayList<Integer> source;
  ArrayList<Integer> heap;
  ArrayList<Integer> sortedHeap;

  Heap(ArrayList<Integer> source) {
    this.source = source;
    this.sortedHeap = new ArrayList<>();
  }

  // EFFECT: modify this heap by producing heap from the source
  public void buildHeap() {
    heap = new ArrayList<>();
    heap.add(this.source.get(0));

    for (int i = 1; i < this.source.size(); i++) {
      heap.add(this.source.get(i));
      upheap(i);
    }
  }

  // EFFECT: upheap the item at the given index in this heap
  public void upheap(int index) {
    int parentIdx = (int) Math.floor((index - 1) / 2);
    int currentItem = this.heap.get(index);
    int parent = this.heap.get(parentIdx);

    if (currentItem > parent) {
      // swap current item with its parent
      this.heap.set(index, parent);
      this.heap.set(parentIdx, currentItem);

      // keep upheaping until <= parent
      upheap(parentIdx);
    }
  }

  // Produce the maximum item from this heap
  // EFFECT: Swap the item at index 0 with the item at the index of the last heap
  // item
  public int removeMax() {
    int lastHeapIdx = this.heap.size() - 1;
    int maxItem = this.heap.get(0);
    int lastItem = this.heap.get(lastHeapIdx);

    this.heap.set(0, lastItem);
    this.heap.set(lastHeapIdx, maxItem);
    this.sortedHeap.add(this.heap.remove(lastHeapIdx));

    downheap(0);

    return maxItem;
  }

  // EFFECT: downheap the item at the given index in this heap
  public void downheap(int index) {
    int leftIdx = (2 * index) + 1;
    int rightIdx = (2 * index) + 2;
    int biggerIdx;
    
    if (inBounds(leftIdx) || inBounds(rightIdx)) {
      biggerIdx = getBiggerIdx(leftIdx, rightIdx); 
    }
    else { // if both are out of bounds, stop
      return; 
    }
 
    int currentItem = this.heap.get(index);
    int biggerItem = this.heap.get(biggerIdx);

    if (currentItem < biggerItem) {
      // Swap items at index and biggestIdx
      this.heap.set(index, biggerItem);
      this.heap.set(biggerIdx, currentItem);

      downheap(biggerIdx);
    }
  }
  

  // produce the index of the largest item at the given two indices
  // assume: at least one index is in bounds
  private int getBiggerIdx(int index1, int index2) {
    int biggerIdx;
    int item1, item2;
    
    if (inBounds(index1)) {
      item1 = this.heap.get(index1);
    }
    else { item1 = -1; }
    
    if (inBounds(index2)) {
      item2 = this.heap.get(index2);
    }
    else { item2 = -1; }
    
    if (item1 > item2) {
      biggerIdx = index1;
    }
    else {
      biggerIdx = index2;
    }
    return biggerIdx;
  }
  
  private boolean inBounds(int index) {
    return index < this.heap.size();
  }
  
  //Helper method to swap two elements in the heap
  private void swap(int i, int j) {
     int temp = heap.get(i);
     heap.set(i, heap.get(j));
     heap.set(j, temp);
  }

}

class ExamplesHeap {

  ArrayList<Integer> list1 = new ArrayList<>(Arrays.asList(1, 2, 3, 4, 5, 6, 7, 8, 9));
  ArrayList<Integer> list2 = new ArrayList<>(Arrays.asList(9, 8, 7, 6, 5, 4, 3, 2, 1));

  void testBuildHeap(Tester t) {
    Heap heap1 = new Heap(list1);
    heap1.buildHeap();
    System.out.println(heap1.source);
    System.out.println(heap1.heap);

    Heap heap2 = new Heap(list2);
    heap2.buildHeap();
    System.out.println(heap2.source);
    System.out.println(heap2.heap);
  }

  void testUpheap(Tester t) {
    // upheaping index=1 (2)
    Heap heap1 = new Heap(list1);
    heap1.heap = new ArrayList<>(Arrays.asList(1, 2));
    heap1.upheap(1);
    t.checkExpect(heap1.heap, new ArrayList<>(Arrays.asList(2, 1)));

    // upheaping index=2 (3)
    heap1.heap.add(3);
    heap1.upheap(2);
    t.checkExpect(heap1.heap, new ArrayList<>(Arrays.asList(3, 1, 2)));

    // upheaping index=3 (4)
    heap1.heap.add(4);
    heap1.upheap(3);
    t.checkExpect(heap1.heap, new ArrayList<>(Arrays.asList(4, 3, 2, 1)));

    // upheaping index=4 (5)
    heap1.heap.add(5);
    heap1.upheap(4);
    t.checkExpect(heap1.heap, new ArrayList<>(Arrays.asList(5, 4, 2, 1, 3)));
  }

  void testRemoveMax(Tester t) {
    Heap heap1 = new Heap(list1);
    heap1.buildHeap();
    t.checkExpect(heap1.removeMax(), 9);
    t.checkExpect(heap1.heap, new ArrayList<>(Arrays.asList(8, 7, 6, 4, 3, 2, 5, 1)));
    t.checkExpect(heap1.sortedHeap, new ArrayList<>(Arrays.asList(9)));

    t.checkExpect(heap1.removeMax(), 8);
    t.checkExpect(heap1.heap, new ArrayList<>(Arrays.asList(7, 4, 6, 1, 3, 2, 5)));
    t.checkExpect(heap1.sortedHeap, new ArrayList<>(Arrays.asList(9, 8)));

    t.checkExpect(heap1.removeMax(), 7);
    t.checkExpect(heap1.heap, new ArrayList<>(Arrays.asList(6, 4, 5, 1, 3, 2)));
    t.checkExpect(heap1.sortedHeap, new ArrayList<>(Arrays.asList(9, 8, 7)));

    ArrayList<Integer> lst = new ArrayList<>(Arrays.asList(80, 70, 50, 30, 60, 40, 20, 10, 20, 15, 50));
    Heap heap2 = new Heap(lst);
    heap2.buildHeap();
    t.checkExpect(heap2.removeMax(), 80);
    t.checkExpect(heap2.heap, new ArrayList<>(Arrays.asList(70, 60, 50, 30, 50, 40, 20, 10, 20, 15)));
  }

}