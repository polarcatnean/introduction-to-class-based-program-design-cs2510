package lab10;

import java.util.ArrayList;
import java.util.Iterator;
import java.util.List;

import tester.Tester;

class CombinedIteratorUtils {
  
  // produce a new Iterator that concatenates the two Iterators
  // this method should terminate even if iter1 or iter2 is an infinitely large Iterator
  static <T> Iterator<T> concat(Iterator<T> iter1, Iterator<T> iter2) {
    return new ConcatIterator<T>(iter1, iter2);
  }
}

class ConcatIterator<T> implements Iterator<T> {
  Iterator<T> iter1;
  Iterator<T> iter2;
  
  ConcatIterator(Iterator<T> iter1, Iterator<T> iter2) {
    this.iter1 = iter1;
    this.iter2 = iter2;
  }

  @Override
  public boolean hasNext() {
    // TODO Auto-generated method stub
    return iter1.hasNext() || iter2.hasNext();
  }

  @Override
  public T next() {
    // TODO Auto-generated method stub
    while (iter1.hasNext()) {
      return iter1.next();
    }
    return iter2.next();
  }
}

class InfiniteIterator implements Iterator<Integer> {
  private int current = 0;

  @Override
  public boolean hasNext() {
    return true; // never ends
  }

  @Override
  public Integer next() {
    return current++;
  }
}

class ExplodingIterator implements Iterator<Integer> {
  @Override
  public boolean hasNext() {
    throw new RuntimeException("Should not be called!");
  }

  @Override
  public Integer next() {
    throw new RuntimeException("Should not be called!");
  }
}


class ExamplesIterators {
  // both iterators empty
  void testBothEmpty(Tester t) {
    ArrayList<Integer> a = new ArrayList<>();
    ArrayList<Integer> b = new ArrayList<>();
    Iterator<Integer> result = CombinedIteratorUtils.concat(a.iterator(), b.iterator());
    
    t.checkExpect(result.hasNext(), false);
  }
  
  // iter1 empty, iter2 not empty
  void testFirstEmptySecondHasElems(Tester t) {
    ArrayList<Integer> a = new ArrayList<>();
    ArrayList<Integer> b = new ArrayList<>(List.of(1, 2, 3));
    Iterator<Integer> result = CombinedIteratorUtils.concat(a.iterator(), b.iterator());
    
    t.checkExpect(result.hasNext(), true);
    t.checkExpect(result.next(), 1);
    t.checkExpect(result.next(), 2);
    t.checkExpect(result.next(), 3);
    t.checkExpect(result.hasNext(), false);
  }
  
  // iter1 not empty, iter 2 empty
  void testFirstHasElemSecondEmpty(Tester t) {
    ArrayList<String> a = new ArrayList<>(List.of("a", "b"));
    ArrayList<String> b = new ArrayList<>();
    Iterator<String> result = CombinedIteratorUtils.concat(a.iterator(), b.iterator());
    
    t.checkExpect(result.hasNext(), true);
    t.checkExpect(result.next(), "a");
    t.checkExpect(result.next(), "b");
    t.checkExpect(result.hasNext(), false);
  }
  
  // Both iterators have elements
  void testBothHaveElements(Tester t) {
    ArrayList<Character> a = new ArrayList<>(List.of('x', 'y'));
    ArrayList<Character> b = new ArrayList<>(List.of('z'));
    Iterator<Character> result = CombinedIteratorUtils.concat(a.iterator(), b.iterator());
    
    t.checkExpect(result.hasNext(), true);
    t.checkExpect(result.next(), 'x');
    t.checkExpect(result.next(), 'y');
    t.checkExpect(result.next(), 'z');
    t.checkExpect(result.hasNext(), false);
  }
  
  // 1st iter infinite
  void testInfiniteIter1StopsAtLimit(Tester t) {
    Iterator<Integer> infinite = new InfiniteIterator();
    Iterator<Integer> shouldNotBeUsed = new ExplodingIterator();
    Iterator<Integer> result = CombinedIteratorUtils.concat(infinite, shouldNotBeUsed);

    for (int i = 0; i < 5; i++) {
      t.checkExpect(result.hasNext(), true);  // always has next
      t.checkExpect(result.next(), i);
    }
  }
}