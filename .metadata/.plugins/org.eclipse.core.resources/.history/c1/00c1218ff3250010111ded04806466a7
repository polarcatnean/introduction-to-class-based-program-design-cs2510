package lab10;

import java.util.ArrayList;
import tester.Tester;

class ListOfLists<T> {
  ArrayList<ArrayList<T>> listoflists;
  
  ListOfLists() {
    this.listoflists = new ArrayList<ArrayList<T>>();
  }
  
  ListOfLists(ArrayList<ArrayList<T>> listoflists) {
    this.listoflists = listoflists;
  }
  
  // EFFECT: adds a new empty ArrayList<T> to the end of the list-of-lists.
  void addNewList() {
    listoflists.add(new ArrayList<T>());
  }
  
  // EFFECT: adds the provided object to the end of the ArrayList<T> 
  // at the provided index in the list-of-lists
  void add(int index, T object) {
    ArrayList<T> list = listoflists.get(index);
    list.add(object);
  }
  
  // returns the ArrayList<T> at the provided index in the list-of-lists
  ArrayList<T> get(int index) {
    return listoflists.get(index);
  }
  
  // returns the number of lists in this list-of-lists
  int size() {
    return listoflists.size();
  }
  
}

