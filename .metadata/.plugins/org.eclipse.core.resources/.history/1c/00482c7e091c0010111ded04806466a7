  // render a board
  WorldImage drawBoard(ArrayList<ArrayList<Tile>> board) {
    WorldImage boardImg = new RectangleImage(constant.WIDTH, constant.HEIGHT, OutlineMode.OUTLINE, Color.BLACK);
    for (ArrayList<Tile> row : board) {
      for (Tile t : row) {
        boardImg = t.drawAt(row.indexOf(t) + 1, board.indexOf(row) + 1, boardImg);      
      }
    }    
    return boardImg;
  }
  
