package lecture28quickmergesort;

import java.util.ArrayList;
import java.util.HashSet;
import java.util.Set;

import tester.Tester;

class Solution {
  public ArrayList<Integer> findEvenNumbers(int[] digits) {
    
    if (!hasEvenNumbers(digits) || digits.length < 3) {
      return new ArrayList<Integer>();
    }
    
    ArrayList<Integer> sortedList = new ArrayList<>(this.permute(digits));
    
    sortedList.sort(null);
    
    int[] result = new int[sortedList.size()];

    for (int i = 0; i < sortedList.size(); i++) {
      result[i] = sortedList.get(i); // Auto-unboxing: Integer → int
    }
    
    
    return sortedList;
  }

  private boolean hasEvenNumbers(int[] digits) {
    for (int i : digits) {
      if (i % 2 == 0) {
        return true;
      }
    }
    return false;
  }
  
  private boolean isEven(int num) {
    return num % 2 == 0;
  }
  
  public Set<Integer> permute(int[] digits) {
    if (digits.length < 3) {
      throw new RuntimeException("array size must be >= 3");
    }
    
    Set<Integer> uniqueNumbers = new HashSet<>();
    
    for (int i = 0; i < digits.length; i++) {
      if (digits[i] == 0) continue;
      
      for (int j = 0; j < digits.length; j++) {
        if (j == i) continue;
        
        for (int k = 0; k < digits.length; k++) {
          if (k == i || k == j || digits[k] % 2 != 0) continue;
            
          int num = digits[i] * 100 + digits[j] * 10 + digits[k];
          uniqueNumbers.add(num);
          
        }
      }
    }    
    return uniqueNumbers; 
  }
}

