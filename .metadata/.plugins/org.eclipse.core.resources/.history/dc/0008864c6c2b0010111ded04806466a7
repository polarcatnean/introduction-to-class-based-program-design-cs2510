class Vertex {
  // any data about vertices, such as people's names, or place's GPS coordinates ...
  List<Edge> outEdges; // edges from this node
  String name;
  
  Vertex(List<Edge> outEdges, String name) {
    this.outEdges = outEdges;
    this.name = name;
  }
  
  String showInfo() {
    return this.name;
  }
  
  boolean hasPathTo(Vertex dest) {
    return this.hasPathToHelper(dest, new ArrayList<Vertex>());
  }

  private boolean hasPathToHelper(Vertex dest, ArrayList<Vertex> visited) {
    for (Edge e : this.outEdges) {
      // check for cycles
      if (!visited.contains(e.to)) {
        visited.add(e.to);
        
        if (e.to == dest || e.to.hasPathToHelper(dest, visited)) {
          return true;
        }
      }
    }
    return false;
  }
}

class Edge {
  Vertex from;
  Vertex to;
  int weight;
  
  Edge(Vertex from, Vertex to, int weight) {
    this.from = from;
    this.to = to;
    this.weight = weight;
  }
}

class Graph {
  List<Vertex> allVertices;
  
  Graph(List<Vertex> allVertices) {
    this.allVertices = allVertices;
  }
  
  // collect all the edges in the graph
  List<Edge> collectAllEdges() {
    List<Edge> edges = new ArrayList<>();  // there can be duplicates if graph is undirected
    
    for (Vertex vertex : allVertices) {
      edges.addAll(vertex.outEdges);
    }

    return edges;
  }
  
  // computes the list of vertices that reach the given vertex
  List<Vertex> inEdges(Vertex v) {
    List<Vertex> vertices = new ArrayList<>();
    
    for (Vertex vertex : allVertices) {
      for (Edge outEdge : vertex.outEdges) {
        if (outEdge.to.equals(v)) {
          vertices.add(vertex);
          break;
        }
      }
    }
    return vertices;
  }
  
  boolean hasPathBetween(Vertex from, Vertex to) {
    Deque<Vertex> visited = new Deque<Vertex>();
    Deque<Vertex> worklist = new Deque<Vertex>();
    
    // initialise the worklist by adding the first item
    worklist.addAtHead(from);
    
    while(!worklist.isEmpty()) {
      Vertex vertex = worklist.removeFromHead();
      if (vertex.equals(to)) {
        return true;
      }
      else if (visited.contains(vertex)) {
        // do nothing
      }
      else {
        for (Edge outEdge : vertex.outEdges) {
          worklist.addAtHead(outEdge.to);
        }
        visited.addAtHead(vertex);
      }
    }
    return false;
  }
  
  // REFACTORing BFS and DFS using Stack and Queue Class
  boolean bfs(Vertex from, Vertex to) {
    return searchHelp(from, to, new Queue<Vertex>());
  }
  
  boolean dfs(Vertex from, Vertex to) {
    return searchHelp(from, to, new Stack<Vertex>());
  }
  
  boolean searchHelp(Vertex from, Vertex to, ICollection<Vertex> worklist) {
    Deque<Vertex> visited = new Deque<Vertex>();
    
    // Initialise the worklist with the from vertex
    worklist.add(from);
    
    while (!worklist.isEmpty()) {
      Vertex vertex = worklist.remove();
      
      if (vertex.equals(to)) {
        return true;
      }
      else if (visited.contains(vertex)) {
        // do nothing
      }
      else {
        // add all the neighbors of next to the worklist for further processing
        for (Edge e : vertex.outEdges) {
          worklist.add(e.to);
        }
        // add vertex to visited
        visited.addAtHead(vertex);
      }
    }
    // We haven't found the to vertex, and there are no more to try
    return false;
  }
  
  
  // Computing the actual path
  List<Vertex> bfsPath(Vertex from, Vertex to) {
    return searchPath(from, to, new Queue<Vertex>());
  }
  
  List<Vertex> dfsPath(Vertex from, Vertex to) {
    return searchPath(from, to, new Stack<Vertex>());
  }
  
  List<Vertex> searchPath(Vertex from, Vertex to, ICollection<Vertex> worklist) {
    Deque<Vertex> visited = new Deque<Vertex>();
    ArrayList<Edge> track = new ArrayList<>();  // edges that were used during traversal
    
    // Initialise the worklist with the from vertex
    worklist.add(from);
    
    while (!worklist.isEmpty()) {
      Vertex vertex = worklist.remove();
      
      if (vertex.equals(to)) {
        // construct a path from edges that were used            
        return this.reconstructPath(track, from, to);
      }
      else if (visited.contains(vertex)) {
        // do nothing
      }
      else {
        // add all the neighbors of next to the worklist for further processing
        for (Edge e : vertex.outEdges) {
          worklist.add(e.to);
          track.add(e);
        }
        // add vertex to visited
        visited.addAtHead(vertex);

      }
    }
    // We haven't found the to vertex, and there are no more to try
    return null;
  }

  private List<Vertex> reconstructPath(ArrayList<Edge> track, Vertex start, Vertex end) {
    List<Vertex> path = new ArrayList<>();
    Vertex current = end;  // start backtracking from the end -> start vertex
    
    while (!current.equals(start)) {
      path.add(current);
      
      // search for the edge that leads to 'current'
      Edge step = null;
      for (Edge e : track) {
        if (e.to.equals(current)) {
          step = e;
          break;
        }
      }
      
      if (step == null) { 
        return null;  // no path found
      }
      
      current = step.from;  // traverse backward when found
    }
    
    path.add(start);  // add starting Vertex at the end
    Collections.reverse(path);
    return path;
  }
}


class ExamplesGraphs {
  Vertex a, b, c, d, e;
  Vertex A, B, C, D, E;
  Edge ab, bc, bd, ca, eb;
  Edge AB, AC, BD, CD, DE;
  Graph graph1, graph2;
  
  void initCyclicGraph() {
    a = new Vertex(new ArrayList<>(), "a");
    b = new Vertex(new ArrayList<>(), "b");
    c = new Vertex(new ArrayList<>(), "c");
    d = new Vertex(new ArrayList<>(), "d");
    e = new Vertex(new ArrayList<>(), "e");
    
    ab = new Edge(a, b, 1);
    bc = new Edge(b, c, 1);
    bd = new Edge(b, d, 1);
    ca = new Edge(c, a, 1);
    eb = new Edge(e, b, 1);
    
    // add edges to vertices
    a.outEdges.add(ab);
    b.outEdges.add(bc);  b.outEdges.add(bd);
    c.outEdges.add(ca);
    e.outEdges.add(eb);
    
    graph1 = new Graph(new ArrayList<>());
    graph1.allVertices.add(a); graph1.allVertices.add(b); graph1.allVertices.add(c);
    graph1.allVertices.add(d); graph1.allVertices.add(e);
  }
  
  void initGraphForBFSDFS() {
    A = new Vertex(new ArrayList<>(), "A");
    B = new Vertex(new ArrayList<>(), "B");
    C = new Vertex(new ArrayList<>(), "C");
    D = new Vertex(new ArrayList<>(), "D");
    E = new Vertex(new ArrayList<>(), "E");
    
    AB = new Edge(A, B, 1);
    AC = new Edge(A, C, 1);
    BD = new Edge(B, D, 1);
    CD = new Edge(C, D, 1);
    DE = new Edge(D, E, 1);
    
    A.outEdges.add(AB); A.outEdges.add(AC);
    B.outEdges.add(BD);
    C.outEdges.add(CD);
    D.outEdges.add(DE);
    
    graph2 = new Graph(new ArrayList<>());
    graph2.allVertices.add(A); graph2.allVertices.add(B); graph2.allVertices.add(C);
    graph2.allVertices.add(D); graph2.allVertices.add(E);
  }
  
  void testHasPathTo(Tester t) {
    this.initCyclicGraph();
    t.checkExpect(a.hasPathTo(b), true);
    t.checkExpect(a.hasPathTo(c), true);
    t.checkExpect(a.hasPathTo(e), false);
    t.checkExpect(a.hasPathTo(d), true);
    t.checkExpect(e.hasPathTo(a), true);
  }
  
  void testHasPathBetween(Tester t) {
    this.initCyclicGraph();
    
    t.checkExpect(graph1.hasPathBetween(b, e), false);
  }
  
  void testSearchPath(Tester t) {
    this.initCyclicGraph();
    initGraphForBFSDFS();

    t.checkExpect(graph1.bfsPath(a, c), new ArrayList<Vertex>(Arrays.asList(a, b, c)));
    t.checkExpect(graph1.bfsPath(b, d), new ArrayList<Vertex>(Arrays.asList(b, d)));
    t.checkExpect(graph1.bfsPath(b, e), null);
    
    t.checkExpect(graph1.dfsPath(a, a), new ArrayList<Vertex>(Arrays.asList(a)));
    t.checkExpect(graph1.dfsPath(a, c), new ArrayList<Vertex>(Arrays.asList(a, b, c)));
//    t.checkExpect(graph1.dfsPath(b, d), new ArrayList<Vertex>(Arrays.asList(b, c, a, d)));
    
    List<Vertex> pathBfs = graph2.bfsPath(A, E);
    List<Vertex> pathDfs = graph2.dfsPath(A, E);
    
    String infoBfs = "Path BFS: "; 
    for (Vertex v : pathBfs) {
      infoBfs = infoBfs.concat(v.showInfo() + ", ");
    }
    System.out.println(infoBfs);
    
    String infoDfs = "Path DFS: "; 
    for (Vertex v : pathDfs) {
      infoDfs = infoDfs.concat(v.showInfo() + ", ");
    }
    System.out.println(infoDfs);
  }
}



