  // produce an empty board, given a board size 
  ArrayList<Cell> createBoard(int size) {
    return new ArrayList<Cell>(size * size);
  }
  
  // EFFECT: fill a given empty board with coloured cells
  void fillBoard(ArrayList<Cell> emptyBoard) {
    int board_size = (int) Math.sqrt(emptyBoard.size());
    for (int y = 0; y < board_size; y++) {
      for (int x = 0; x < board_size; x++) {
        Cell cell = new Cell(x, y);
        emptyBoard.add(cell);
      }
    }
  }
  
  // EFFECT: Modify each cell in the board by setting its four adjacent cells
  void linkNeighbourCells(ArrayList<Cell> board) {
    for (int i = 0; i < board.size(); i++) {
      board.get(i).setAdjacents(board, i);
    }
    
    // Set the top-left cell (0,0) as initially flooded
    board.get(0).flooded = true;
  }

  public void startGame() {
