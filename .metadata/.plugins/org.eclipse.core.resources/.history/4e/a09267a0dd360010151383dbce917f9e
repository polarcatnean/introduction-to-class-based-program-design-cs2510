package lecture29heappriorityqueue;

import java.sql.Array;
import java.util.ArrayList;
import java.util.Arrays;

import tester.Tester;

class Heap {
  ArrayList<Integer> source;
  ArrayList<Integer> heap;
  
  Heap(ArrayList<Integer> source) {
    this.source = source;
  }
  
  // produce a heap from this ArrayList
  public void buildHeap() {
    heap = new ArrayList<>();
    heap.add(this.source.get(0));
    
    for (int i = 1; i < this.source.size(); i++) {
      heap.add(this.source.get(i));
      upheap(i);
    }

  }

  private void upheap(int index) {
    int parentIdx = (int) Math.floor((index - 1) / 2);
    int currentItem = this.heap.get(index);
    int parent = this.heap.get(parentIdx);
    
    if (currentItem > parent) {
      // swap current item with its parent
      this.heap.set(index, parent);
      this.heap.set(parentIdx, currentItem);
      
      upheap(parentIdx);
    }
  }
  
  
}


class ExamplesHeap {
  
  ArrayList<Integer> list1 = new ArrayList<>(Arrays.asList(1, 2, 3, 4, 5, 6, 7, 8, 9));
  
  void testBuildHeap(Tester t) {
    Heap heap1 = new Heap(list1);
    heap1.buildHeap();
    
    System.out.println(heap1.source);
    System.out.println(heap1.heap);
  }
  
}