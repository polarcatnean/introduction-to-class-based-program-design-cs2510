package lecture28quickmergesort;

import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;
import java.util.Random;

import tester.Tester;

class Solution {
  Random rand = new Random();

  public ArrayList<Integer> findEvenNumbers(int[] digits) {
    ArrayList<Integer> numbers = new ArrayList<Integer>();
    
    if (!hasEvenNumbers(digits) || digits.length < 3) {
      return numbers;
    }
    
    ArrayList<Integer> combo = this.permute(digits);
    for (int i : combo) {
      if (isEven(i) && !numbers.contains(i)) {
        numbers.add(i);
      }
    }
    
    int[] arr = new int[numbers.size()];

    for (int i = 0; i < numbers.size(); i++) {
        arr[i] = numbers.get(i); // Auto-unboxing: Integer → int
    }
    
    
    return numbers;
  }

  private boolean hasEvenNumbers(int[] digits) {
    for (int i : digits) {
      if (i % 2 == 0) {
        return true;
      }
    }
    return false;
  }
  
  private boolean isEven(int num) {
    return num % 2 == 0;
  }
  
  public ArrayList<Integer> permute(int[] digits) {
    if (digits.length < 3) {
      throw new RuntimeException("array size must be >= 3");
    }
    
    List<Integer> source = new ArrayList<>();
    for (int num : digits) {
      source.add(num); // Autoboxing: int → Integer automatically
    }
    
    ArrayList<Integer> combo = new ArrayList<Integer>();
    
    for (int i = 0; i < digits.length; i++) {
      int firstDigit = source.get(i);
      for (int j = 0; j < digits.length; j++) {
        for (int k = 0; k < digits.length; k++) {
          if (i != j && j != k && i != k && firstDigit != 0) {
            int num = (firstDigit * 100) + (source.get(j) * 10) + source.get(k);
            combo.add(num);
          }
        }
      }
    }    
    return combo; 
  }
}

class ExamplesNumbers {
  Solution solution = new Solution();
  int[] list1 = {2,1,3,0};
  int[] list2 = {2,2,8,8,2};
  int[] list3 = {3,7,5};
  
  void testPermute(Tester t) {
    System.out.println(solution.permute(list3));
  }
  
  void testFindEvenNumbers(Tester t) {
    System.out.println(solution.findEvenNumbers(list1));
    System.out.println(solution.findEvenNumbers(list2));
    System.out.println(solution.findEvenNumbers(list3));
  }
}