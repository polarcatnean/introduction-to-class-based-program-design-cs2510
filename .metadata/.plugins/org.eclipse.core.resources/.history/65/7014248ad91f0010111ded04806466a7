// Represents an individual tile
class Tile {
  // The number on the tile (1-15).  Use 0 to represent the hole
  int value;
  Const c = new Const();
  
  Tile(int value) { this.value = value; }

  // Draws this tile onto the background at the specified logical coordinates
  WorldImage drawAt(int col, int row, WorldImage background) { 
    background = background.movePinhole(-c.WIDTH / 2, -c.WIDTH / 2);  // pinhole at Upper Left corner
    OutlineMode outline;
    
    if (this.value == 0) {
      outline = OutlineMode.SOLID;     // black cell (hole)
    }
    else {
      outline = OutlineMode.OUTLINE;
    }
    
    WorldImage cell = new OverlayImage(
        new RectangleImage(c.tileSize, c.tileSize, outline, Color.GRAY),
        new TextImage(Integer.toString(this.value), c.fontSize, c.style, c.fontColor)
        )
        .movePinhole(c.tileSize / 2, c.tileSize / 2); // pinhole at Lower Right corner
    
    WorldImage cellWithPinHole = new VisiblePinholeImage(cell, Color.RED);
    WorldImage bgWithPinHole = new VisiblePinholeImage(background, Color.BLUE);
    
    return new OverlayOffsetImage(bgWithPinHole,    // top
                                  col * c.tileSize, row * c.tileSize,
                                  cellWithPinHole); // bottom
  }
}
 
class FifteenGame extends World {
  // represents the rows of tiles 
  ArrayList<ArrayList<Tile>> tiles;
  Const constant = new Const();
  
  // Examples
  Tile tile0 = new Tile(0);
  Tile tile1  = new Tile(1);  Tile tile2  = new Tile(2);  Tile tile3  = new Tile(3);  Tile tile4  = new Tile(4);
  Tile tile5  = new Tile(5);  Tile tile6  = new Tile(6);  Tile tile7  = new Tile(7);  Tile tile8  = new Tile(8);
  Tile tile9  = new Tile(9);  Tile tile10 = new Tile(10); Tile tile11 = new Tile(11); Tile tile12 = new Tile(12);
  Tile tile13 = new Tile(13); Tile tile14 = new Tile(14); Tile tile15 = new Tile(15);
  ArrayList<Tile> row1 = new ArrayList<Tile>(Arrays.asList(tile1,  tile2,  tile3,  tile4));
  ArrayList<Tile> row2 = new ArrayList<Tile>(Arrays.asList(tile5,  tile6,  tile7,  tile8));
  ArrayList<Tile> row3 = new ArrayList<Tile>(Arrays.asList(tile9,  tile10, tile11, tile12));
  ArrayList<Tile> row4 = new ArrayList<Tile>(Arrays.asList(tile13, tile14, tile15, tile0));
  ArrayList<ArrayList<Tile>> board1 = new ArrayList<>(Arrays.asList(row1, row2, row3, row4));
  
  ArrayList<ArrayList<Tile>> boardTest = new ArrayList<>(Arrays.asList(row1));
  
  
  // draws the game
  public WorldScene makeScene() { 
    // TODO
    WorldScene scene = this.getEmptyScene();
    WorldImage boardImg = this.drawBoard(board1);

    scene.placeImageXY(boardImg, constant.WIDTH / 2, constant.WIDTH / 2);

    return scene;
  }
  
  // render a board
  WorldImage drawBoard(ArrayList<ArrayList<Tile>> board) {
    WorldImage boardImg = new RectangleImage(constant.WIDTH, constant.HEIGHT, OutlineMode.OUTLINE, Color.BLACK);
    for (ArrayList<Tile> row : board) {
      for (Tile t : row) {
        boardImg = t.drawAt(row.indexOf(t) + 1, board.indexOf(row) + 1, boardImg);
      }
    }    
    return boardImg;
  }
  
  // handles keystrokes
  public void onKeyEvent(String key) {
    int col0 = this.getCol(tile0);
    int row0 = this.getRow(tile0);
    
    if (key == "up") {
      // swap hole with col, row+1 (if tile exists)
      if (this.swappable(col0, row0 + 1)) {
        this.swapTiles(row0, col0, row0 + 1, col0);
      }
    }
    else if (key == "down") {
      // swap hole with col, row-1
      if (this.swappable(col0, row0 - 1)) {
        this.swapTiles(row0, col0, row0 - 1, col0);
      }
    }
    else if (key == "left") {
      // swap hole with col+1, row
      if (this.swappable(col0 + 1, row0)) {
        this.swapTiles(row0, col0, row0, col0 + 1);
      }
    }
    else if (key == "right") {
      // swap hole with col-1, row
      if (this.swappable(col0 - 1, row0)) {
        this.swapTiles(row0, col0, row0, col0 - 1);
      }
    }
    else if (key == "u") {
      // extra: handle "u" to undo moves
      // undo latest move
    }
  }
  
  
  public void startGame() {
    super.bigBang(constant.WIDTH, constant.HEIGHT);
  }
  
  Tile getTile(int row, int col) {
    return this.tiles.get(row).get(col);  // First get row ArrayList, then tile
  }
  
  void setTile(int row, int col, Tile newTile) {
    this.tiles.get(row).set(col, newTile);
  }
  
  void swapTiles(int row1, int col1, int row2, int col2) {
    Tile oldTile1 = this.getTile(row1, col1);
    Tile oldTile2 = this.getTile(row2, col2);
    this.setTile(row2, col2, oldTile1);
    this.setTile(row1, col1, oldTile2);
  }
  
  // produce the column index of this tile, or -1 if not found
  int getCol(Tile tile) {
    for (int row = 0; row < this.tiles.size(); row++) {
      for (int col = 0; col < this.tiles.get(row).size(); col++) {
        if (this.tiles.get(row).get(col).value == tile.value) {
          return col;
        }
      }
    }
    return -1;
  }
  
  // produce the row index of this tile
  int getRow(Tile tile) {
    for (int row = 0; row < this.tiles.size(); row++) {
      for (int col = 0; col < this.tiles.get(row).size(); col++) {
        if (this.tiles.get(row).get(col).value == tile.value) {
          return row;
        }
      }
    }
    return -1;
  }
  
  boolean swappable(int col, int row) {
    return col >= 0 && col < 4 && row >= 0 && row < 4;
  }
  
  
}

class ExampleFifteenGame {
  Tile tile0, tile1, tile2, tile3, tile4, tile5, tile6, tile7, tile8, tile9, tile10, tile11, tile12,
      tile13, tile14, tile15;
  ArrayList<Tile> row1, row2, row3, row4;
  ArrayList<ArrayList<Tile>> board1;
  
  FifteenGame game;
  
  void init() {
    tile0 = new Tile(0);
    tile1  = new Tile(1);  tile2  = new Tile(2);  tile3  = new Tile(3);  tile4  = new Tile(4);
    tile5  = new Tile(5);  tile6  = new Tile(6);  tile7  = new Tile(7);  tile8  = new Tile(8);
    tile9  = new Tile(9);  tile10 = new Tile(10); tile11 = new Tile(11); tile12 = new Tile(12);
    tile13 = new Tile(13); tile14 = new Tile(14); tile15 = new Tile(15);
    
    row1 = new ArrayList<Tile>(Arrays.asList(tile1,  tile2,  tile3,  tile4));
    row2 = new ArrayList<Tile>(Arrays.asList(tile5,  tile6,  tile7,  tile8));
    row3 = new ArrayList<Tile>(Arrays.asList(tile9,  tile10, tile11, tile12));
    row4 = new ArrayList<Tile>(Arrays.asList(tile13, tile14, tile15, tile0));
    
    board1 = new ArrayList<>(Arrays.asList(row1, row2, row3, row4));
    
    game = new FifteenGame();
    game.tiles = board1;
  }
  
  void testArrayTiles(Tester t) {
    init();
    
    // getTile
    t.checkExpect(game.getTile(2, 1), tile10);
    t.checkExpect(game.getTile(3, 3), tile0);
    
    // setTile
    game.setTile(2, 1, tile15);
    t.checkExpect(game.getTile(2, 1), tile15);
  }
  
  void testSwapTiles(Tester t) {
    init();
    game.swapTiles(2, 3, 3, 3);                   // swap 0->12
    t.checkExpect(game.getTile(2, 3), tile0);
    t.checkExpect(game.getTile(3, 3), tile12);
    
    game.swapTiles(2, 3, 3, 3);                   // swap back
    t.checkExpect(game.getTile(2, 3), tile12);
    t.checkExpect(game.getTile(3, 3), tile0);
    
    game.swapTiles(3, 2, 3, 3);                   // swap 0->15
    t.checkExpect(game.getTile(3, 2), tile0);
    t.checkExpect(game.getTile(3, 3), tile15);
    
    t.checkExpect(game.getCol(tile0), 2);
    t.checkExpect(game.getRow(tile0), 3);
    t.checkExpect(game.getCol(tile5), 0);
    t.checkExpect(game.getRow(tile5), 1);
    
  }
  
  void testGame(Tester t) {
    init();
    game.startGame();
  }
  
}


