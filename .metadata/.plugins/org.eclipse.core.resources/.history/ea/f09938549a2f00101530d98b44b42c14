package lecture28quickmergesort;

import java.util.ArrayList;
import java.util.HashMap;

import tester.Tester;

class Solution {
  HashMap<Character, String> letterMap = this.alphabetMap();
  
  public String lengthAfterTransformations(String s, int t) {
//    int length = transformHelper(s, t).length();  
//    return (int) (length % (Math.pow(10, 9) + 7));
    
    return transformHelper(s, t);
  }

  private String transformHelper(String s, int t) {
    String result = "";
    char[] source = s.toCharArray();

    for (char c : source) {
      result.concat(letterMap.get(c));
    }
       
    
    while (t != 0) {
      transformHelper(result, t - 1);
    }
    
    return result;
  }
  
  private HashMap<Character, String> alphabetMap() {
    HashMap<Character, String> letterMap = new HashMap<>();
    
    for (char c = 'a'; c < 'z'; c++) {
      letterMap.put(c, String.valueOf((char)(c + 1)));
    }  
    letterMap.put('z', "ab");
    
    return letterMap;
  }
  
}

class ExamplesLeet {
  Solution solution = new Solution();
 
  void testTransform(Tester t) {
    System.out.println(solution.lengthAfterTransformations("abcyy", 2));
  }
}