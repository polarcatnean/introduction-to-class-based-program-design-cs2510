// Represents a single square of the game area
class Cell {
  // In logical coordinates (grid indices), with the origin at the top-left corner of the screen
  int x, y;      // [0, BOARD_SIZE)
  Color color;   // random 6 colour
  boolean flooded;
  // the four adjacent cells to this one
  Cell left;    
  Cell top;     
  Cell right;   
  Cell bottom;  
  
  Cell(int x, int y) {
    this.x = x;
    this.y = y;
    this.color = FloodItWorld.COLORS.get(new Random().nextInt(FloodItWorld.COLORS.size()));
    this.flooded = false; 
    this.left = null;
    this.top = null;
    this.right = null;
    this.bottom = null;
  }
  
  // EFFECT: set pointers to the four adjacent neighbour cells, given a board and this cell's index
  void setAdjacents(ArrayList<Cell> board, int index) {
    int board_size = FloodItWorld.BOARD_SIZE;
    
    // Left neighbor (if not in the first column)
    if (x > 0) {
      this.left = board.get(index - 1);
    }
    
    // Right neighbor (if not in the last column)
    if (x < board_size - 1) {
      this.right = board.get(index + 1);
    }
    
    // Top neighbor (if not in the first row)
    if (y > 0) {
      this.top = board.get(index - board_size);
    }
    
    // Bottom neighbor (if not in the last row)
    if (y < board_size - 1) {
      this.bottom = board.get(index + board_size);
    }
    
  }
  
  WorldImage drawCell() {
    int cell_size = FloodItWorld.CELL_SIZE;

    int offsetX = this.x * cell_size + cell_size / 2;
    int offsetY = this.y * cell_size + cell_size / 2;
    
    WorldImage cellImg = new RectangleImage(cell_size, cell_size, OutlineMode.SOLID, this.color);                            
    
    // for debugging 
    int i = (this.y * FloodItWorld.BOARD_SIZE) + this.x;
    WorldImage index = new TextImage(Integer.toString(i), Color.BLACK);    
    WorldImage idxCellImg = new OverlayImage(index, cellImg);
    
    return idxCellImg.movePinholeTo(new Posn(-offsetX, -offsetY));  // move pinhole to absolute position;
  }
  
  // EFFECT: check the adj cells, if same colour with colour clicked, flood it
  void floodAdjacents(Color oldColour, Color toColour) {
    if (this.left != null && this.left.color.equals(oldColour)) {
      this.left.flood(toColour);
    }
    if (this.right != null && this.right.color.equals(oldColour)) {
      this.right.flood(toColour);
    }
    if (this.top != null && this.top.color.equals(oldColour)) {
      this.top.flood(toColour);
    }
    if (this.bottom != null && this.bottom.color.equals(oldColour)) {
      this.bottom.flood(toColour);
    }
  }

  // EFFECT: modify the colour of this cell to be the given colour
  // and set flooded to true
  void flood(Color newColour) {
    this.color = newColour;
    this.flooded = true;
  }
  
}


class FloodItWorld extends World {
  // All the cells of the game
  ArrayList<Cell> board;
  Random random = new Random();
  int totalClicks;
  boolean floodingState;
  ArrayList<Cell> worklist;
  ArrayList<Cell> visited;
  Color floodColour;

  // Defines int constants 
  static int BOARD_SIZE = 10; // 14 cells
  static int CELL_SIZE = 30; // 20 px
  static int BOARD_WIDTH = BOARD_SIZE * CELL_SIZE;
  static int PADDING_X = 100;
  static int PADDING_Y = 20;
  static int CENTER_X = (BOARD_WIDTH + (PADDING_X * 2))/ 2;
  static int SCORE_Y = PADDING_Y + BOARD_WIDTH + 30;
  static int TEXT_Y = PADDING_Y + BOARD_WIDTH + 80;
  static int MAX_CLICKS = 25; 
  static double TICK_RATE = 1.0 / 28.0;

  // Colours
  static Color eucalyptus = new Color(83, 200, 172);
  static Color yellowGreen = new Color(170, 214, 132);
  static Color sunny = new Color(251, 248, 125);
  static Color topaz = new Color(252, 198, 110);
  static Color mauvelous = new Color(242, 152, 177);
  static Color purple = new Color(152, 118, 177);
  static ArrayList<Color> COLORS = new ArrayList<Color>(
      Arrays.asList(eucalyptus, yellowGreen, sunny, topaz, mauvelous, purple));


  // constructor
  FloodItWorld() {
    this.BOARD_SIZE = 10;
    this.createNewBoard();    
  }
  
  FloodItWorld(int size) {
    this.BOARD_SIZE = size;
    this.createNewBoard();    
  }
  
  // EFFECT: set this game's board to a new board
  void createNewBoard() {
    this.board = new ArrayList<Cell>(BOARD_SIZE * BOARD_SIZE);
    this.totalClicks = 0;
    this.floodingState = false;
    this.worklist = new ArrayList<Cell>();
    this.visited = new ArrayList<Cell>();
    this.floodColour = null;
    
    // create cells
    fillBoard();
    
    // link neighbours
    linkNeighbourCells();
    
    // Set the top-left cell (0,0) as initially flooded and add to the initial worklist
    board.get(0).flooded = true;
    worklist.add(board.get(0));
  }
  
  // EFFECT: Fill this game's board with coloured cells
  void fillBoard() {
    for (int y = 0; y < BOARD_SIZE; y++) {
      for (int x = 0; x < BOARD_SIZE; x++) {
        Cell cell = new Cell(x, y);
        this.board.add(cell);
      }
    }
  }
  
  // EFFECT: Modify each cell in the board by setting its four adjacent cells
  void linkNeighbourCells() {
    for (int i = 0; i < board.size(); i++) {
      board.get(i).setAdjacents(board, i);
    }
  }

  public void launch() {
    int paddingY = 150;
    int windowWidth = BOARD_WIDTH + (PADDING_X * 2);
    int windowHeight = BOARD_WIDTH + paddingY;

    super.bigBang(windowWidth, windowHeight, TICK_RATE);
  }

  @Override
  public WorldScene makeScene() {
    WorldScene scene = this.getEmptyScene();
    WorldImage boardImg = this.drawBoard();
    WorldImage border = this.drawBorder();
    
    WorldImage boardWithBorder = new OverlayImage(boardImg, border);

    scene.placeImageXY(boardWithBorder, PADDING_X, PADDING_Y); // align top left corner of the board with offsets
    scene.placeImageXY(drawScore(), CENTER_X, SCORE_Y);
    
    return scene;
  }
  
  private WorldImage drawBoard() {
    WorldImage canvas = new RectangleImage(
        BOARD_SIZE * CELL_SIZE,
        BOARD_SIZE * CELL_SIZE,
        OutlineMode.SOLID,
        Color.LIGHT_GRAY  
    ).movePinhole(-BOARD_SIZE * CELL_SIZE/2, -BOARD_SIZE * CELL_SIZE/2);
    
    for (Cell cell : this.board) {
      canvas = new OverlayImage(cell.drawCell(), canvas);
    }  
    return canvas;
  }
  
  private WorldImage drawBorder() {
    int paddingBorder = 10;
    int borderImgWidth = BOARD_WIDTH + paddingBorder;
    
    WorldImage border = new RectangleImage(borderImgWidth, borderImgWidth, OutlineMode.SOLID, Color.BLACK)
        .movePinhole(-(borderImgWidth - paddingBorder)/2, -(borderImgWidth - paddingBorder)/2);
    
    return border;
  }
  
  private WorldImage drawScore() {
    String score = this.totalClicks + " / " + MAX_CLICKS;
    WorldImage scoreImg = new TextImage(score, 24, FontStyle.BOLD, Color.BLACK);
    
    return scoreImg;
  }
  
  // BFS worklist
  // add adjacents to the end of the worklist
  private void buildWorklist() {

    while (worklist.size() > 0) {
      Cell currentCell = worklist.remove(0);
      currentCell.color = floodColour;
      visited.add(currentCell);
      
      
      tryAddToWorklist(currentCell.left);
      tryAddToWorklist(currentCell.right);
      tryAddToWorklist(currentCell.top);
      tryAddToWorklist(currentCell.bottom);
    }

  }
  
  private void tryAddToWorklist(Cell cell) {
    // check: not null, same colour as colour clicked, 
    if (!visited.contains(cell) && cell != null && floodColour.equals(cell.color)) {
      worklist.add(cell);
      cell.flooded = true; 
      System.out.println("Added to worklist Cell " + cell.y + cell.x);
    }
  }

  
  // TODO
  public void onTick() {
    if (floodingState) {
      int cellsToProcess = worklist.size(); // Process only current layer
      
      // start flooding by going through the worklist      
      for (int i = 0; i < cellsToProcess; i++) {
        Cell currentCell = worklist.remove(0);
        currentCell.color = floodColour;
        visited.add(currentCell);
        
        
        tryAddToWorklist(currentCell.left);
        tryAddToWorklist(currentCell.right);
        tryAddToWorklist(currentCell.top);
        tryAddToWorklist(currentCell.bottom);
      }
            
      // finished flooding
      if (worklist.isEmpty()) {
        floodingState = false;
      }
      
    }
    
  }
  
  public void onKeyEvent(String key) {
    // reset the game and create a new board
    if (key.equals("r")) {
      this.createNewBoard();
      
      System.out.println("Board reset.");
    }
  }
  
  public void onMouseClicked(Posn pos) {
    // Only start new flood if not currently flooding
    if (inBounds(pos) && !floodingState) {     
      // convert mouse position to cell indices (x, y)   
      int cellX = getCellX(pos.x); 
      int cellY = getCellY(pos.y);
      System.out.println("Pos x clicked: " + pos.x);
      System.out.println("Pos y clicked: " + pos.y);
      System.out.println("Cell x: " + cellX);
      System.out.println("Cell y: " + cellY);
      System.out.println("----------------");
      
      // get the cell at this position and its colour
      floodColour = this.getCell(cellX, cellY).color;
      Color oldColour = board.get(0).color;
      
      // if the colour clicked is the same as the flooded area, do not flood
      // if different colour -> flood with that colour  
      if (!floodColour.equals(oldColour)) {
        floodingState = true;
        //floodCells(floodColour); // OLD implementation (no waterfall effect)
      }      
      
      // update total clicks so far
      this.totalClicks++;
    }
  }
  
  // return true if given pos is within the board
  private boolean inBounds(Posn pos) {   
    return pos.x >= PADDING_X && pos.x <= PADDING_X + BOARD_WIDTH
        && pos.y >= PADDING_Y && pos.y <= PADDING_Y + BOARD_WIDTH;
  }

  // produce the cell from this board from given x, y (grid indices)
  private Cell getCell(int x, int y) {
    if (x > BOARD_SIZE - 1 || y > BOARD_SIZE - 1) {
       throw new IndexOutOfBoundsException("x or y is larger than board size.");
    }
    return board.get(y * BOARD_SIZE + x);
  }
  
  // produce cell X position (grid index) from Posn
  private int getCellX(int posX) {
    return (int) Math.floor((posX - PADDING_X) / CELL_SIZE); 
  }
  
  //produce cell Y position (grid index) from Posn
   private int getCellY(int posY) {
     return (int) Math.floor((posY - PADDING_Y) / CELL_SIZE);
   }
  
  // EFFECT: modify the board by "flooding" the board with the colour of clicked cell
   private void floodCells(Color colourClicked) {
    // starting from top-left
    Color oldColour = board.get(0).color;
    
    for (Cell cell : board) {
      if (cell.flooded) {
        cell.color = colourClicked;
        cell.floodAdjacents(oldColour, colourClicked);
      }
    }
  }
  
  
  public WorldEnd worldEnds() {
    if (isGameWon()) {
      System.out.println("Game over: You won!"); // Debug
      return new WorldEnd(true, this.makeWinningScene());
    } 
    else if (isOutOfSteps()) {
      System.out.println("Game over: Out of steps!"); // Debug
      return new WorldEnd(true, this.makeLosingScene());
    }
    else {
      return new WorldEnd(false, this.makeScene());
    }
  }

  // Checks if the game is won 
  // return true if all cells match the flood color and the player hasn't run out of steps.
  private boolean isGameWon() {
    if (totalClicks > MAX_CLICKS) {
      return false;
    }
    
    Color floodColour = board.get(0).color;
    
    for (Cell cell : this.board) {
      if (!cell.color.equals(floodColour)) {
        return false;
      }
    }
    
    return true;
  }

  // return true if player ran out of steps
  private boolean isOutOfSteps() {
    return totalClicks >= MAX_CLICKS;
  }

  private WorldScene makeWinningScene() {
    WorldScene currentGameScene = this.makeScene();
    WorldImage winText = new TextImage("You Won!", 24, FontStyle.BOLD, Color.BLACK);  

    currentGameScene.placeImageXY(winText, CENTER_X, TEXT_Y);
    return currentGameScene;
  }
  
  private WorldScene makeLosingScene() {
    WorldScene currentGameScene = this.makeScene();
    WorldImage loseText = new TextImage("Game Over: Out of steps!", 24, FontStyle.BOLD, Color.BLACK);

    currentGameScene.placeImageXY(loseText, CENTER_X, TEXT_Y);
    return currentGameScene;
  }


}


