package lab11;

import java.util.ArrayList;
import java.util.Arrays;

import tester.Tester;

class Curriculum {
  ArrayList<Course> courses;
  
  Curriculum() { this.courses = new ArrayList<Course>(); }
  
  // EFFECT: adds another course to the set of known courses
  void addCourse(Course c) { 
    this.courses.add(c); 
  }
  
  // produce true if the provided Course appears in the schedule 
  // AFTER all of its prerequisites do
  // and all the prerequisites appear in the schedule
  boolean comesAfterPrereqs(ArrayList<Course> schedule, Course c) {
    for (Course prereq : c.prereqs) {
      if (schedule.indexOf(c) < schedule.indexOf(prereq)) {
        return false;
      }
    }  
    return true;
  }
  
  // produce true if the schedule is valid for all the courses in it
  boolean validSchedule(ArrayList<Course> schedule) {
    for (Course course : schedule) {
      if (!comesAfterPrereqs(schedule, course)) {
        return false;
      }
    }
    return true;    
  }
  
}

class Course {
  String name;
  ArrayList<Course> prereqs;
  
  Course(String name) { 
    this.name = name; 
    this.prereqs = new ArrayList<Course>(); 
  }
  
  // EFFECT: adds a course as a prereq to this one
  void addPrereq(Course c) { 
    this.prereqs.add(c); 
  }
}

class ExampleCurriculums {
  Curriculum c1 = new Curriculum();
  
  Course fundies1 = new Course("Fundamentals 1");
  Course fundies2 = new Course("Fundamentals 2");
  Course dd = new Course("Database Design");
  Course algo = new Course("Algorithms and Data");
  Course sys = new Course("Computer Systems");
  Course ood = new Course("Object-Oriented Design");
  Course theory = new Course("Theory of Computation");
  Course parallel = new Course("Large-Scale Parallel Data Processing");
  Course lang = new Course("Programming Languages");
  Course compilers = new Course("Compilers");
  
  void initPrereqs() {   
    c1.courses = new ArrayList<Course>(
        Arrays.asList(fundies1, fundies2, dd, algo, sys, ood, theory, parallel, lang, compilers));
    
    dd.addPrereq(fundies1);
    fundies2.addPrereq(fundies1);
    algo.addPrereq(fundies2);
    sys.addPrereq(fundies2);
    ood.addPrereq(fundies2);
    theory.addPrereq(fundies2);
    parallel.addPrereq(algo); parallel.addPrereq(sys);
    lang.addPrereq(ood); lang.addPrereq(theory);
    compilers.addPrereq(lang);
  }
  
  void testComesAfterPrereqs(Tester t) {
    initPrereqs();
    ArrayList<Course> s0 = new ArrayList<Course>(); // empty list
    ArrayList<Course> s1 = new ArrayList<Course>(Arrays.asList(fundies1)); // no prereq
    ArrayList<Course> s2 = new ArrayList<Course>(Arrays.asList(fundies1, fundies2)); // correct 1 prereq
    ArrayList<Course> s3 = new ArrayList<Course>(Arrays.asList(fundies2)); // missing a prereq
    ArrayList<Course> s4 = new ArrayList<Course>(
        Arrays.asList(fundies1, fundies2, ood, theory, lang, compilers)); // correct order prereqs
    ArrayList<Course> s5 = new ArrayList<Course>(
        Arrays.asList(fundies1, fundies2, ood, lang, compilers)); // correct order, missing one prereq
    ArrayList<Course> s6 = new ArrayList<Course>(
        Arrays.asList(fundies1, fundies2, ood, lang, theory, compilers));  // wrong order
    
    t.checkExpect(c1.comesAfterPrereqs(s1, fundies1), true);
    t.checkExpect(c1.comesAfterPrereqs(s2, fundies2), true);
    t.checkExpect(c1.comesAfterPrereqs(s3, fundies2), false);
    t.checkExpect(c1.comesAfterPrereqs(s4, compilers), true);
    t.checkExpect(c1.comesAfterPrereqs(s5, compilers), false);
    t.checkExpect(c1.comesAfterPrereqs(s6, compilers), false);
  }
}