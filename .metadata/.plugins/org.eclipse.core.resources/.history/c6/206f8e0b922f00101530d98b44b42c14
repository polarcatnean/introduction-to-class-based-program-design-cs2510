class Solution {
  Random rand = new Random();

  public int[] findEvenNumbers(int[] digits) {
    int[] numbers = new int[0];
    int firstIndex, secondIndex, lastIndex;
    int firstDigit, secondDigit, lastDigit;
    
    if (!hasEvenNumbers(digits) || digits.length < 3) {
      return numbers;
    }

    
    
    return numbers;
  }

  private boolean hasEvenNumbers(int[] digits) {
    for (int i : digits) {
      if (i % 2 == 0) {
        return true;
      }
    }
    return false;
  }
  
  public ArrayList<Integer> permute(int[] digits) {
    if (digits.length < 3) {
      throw new RuntimeException("array size must be >= 3");
    }
    
    List<Integer> source = new ArrayList<>();
    for (int num : digits) {
      source.add(num); // Autoboxing: int → Integer automatically
    }
    
    ArrayList<Integer> combo = new ArrayList<Integer>();
    
    for (int i = 0; i < digits.length; i++) {
      int firstDigit = source.get(i);
      for (int j = 0; j < digits.length; j++) {
        for (int k = 0; k < digits.length; k++) {
          if (i != j && j != k && i != k && firstDigit != 0) {
            int num = (firstDigit * 100) + (source.get(j) * 10) + source.get(k);
            combo.add(num);
          }
        }
      }
    }    
    return combo; 
  }
}

