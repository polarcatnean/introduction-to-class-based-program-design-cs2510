package lecture29heappriorityqueue;

import java.util.ArrayList;
import java.util.Arrays;

import tester.Tester;

class Heap {
  ArrayList<Integer> source;
  ArrayList<Integer> heap;
  ArrayList<Integer> sortedHeap;
  int lastHeapIdx;

  Heap(ArrayList<Integer> source) {
    this.source = source;
    this.heap = new ArrayList<>();
    this.sortedHeap = new ArrayList<>();
    this.lastHeapIdx = this.source.size() - 1;
  }

  // EFFECT: modify this heap by producing heap from the source
  // using upheap-based solution
  public void buildHeap() {
    if (this.source.isEmpty()) {
      return;
    }
    
    heap.add(this.source.get(0));

    for (int i = 1; i < this.source.size(); i++) {
      heap.add(this.source.get(i));
      upheap(i);
    }
  }
  
  // EFFECT: modify this heap by producing heap from the source
  // downheap-based solution
  public void buildHeapAlt() {
    if (this.source.isEmpty()) {
      return;
    }
    
    // copy source to heap
    for (int item : this.source ) {
      this.heap.add(item);
    }
    
    // counting from the first half down to 0
    for (int i = this.heap.size()/2 - 1; i >= 0; i--) {
      downheap(i);
    }
  }

  // EFFECT: upheap the item at the given index in this heap
  public void upheap(int index) {
    int parentIdx = (int) Math.floor((index - 1) / 2);
    int currentItem = this.heap.get(index);
    int parent = this.heap.get(parentIdx);

    if (currentItem > parent) {
      // swap current item with its parent
      swap(index, parentIdx);

      // keep upheaping until <= parent
      upheap(parentIdx);
    }
  }

  // Produce the maximum item from this heap
  // EFFECT: Swap the item at index 0 with the item at the index of the last heap item
  public int removeMax() {
    int maxItem = this.heap.get(0);

    swap(0, this.lastHeapIdx);
    this.lastHeapIdx--;
    
    downheap(0);

    return maxItem;
  }

  // EFFECT: downheap the item at the given index in this heap
  public void downheap(int index) {
    int largestIdx = index; // Assume current node is the largest
    int leftIdx = (2 * index) + 1;
    int rightIdx = (2 * index) + 2;
    int size = this.lastHeapIdx + 1;
    
    // Check if left child is larger than current node
    if (leftIdx < size && heap.get(leftIdx) > heap.get(largestIdx)) {
      largestIdx = leftIdx;
    }
 
    // Check if right child is larger than current node
    if (rightIdx < size && heap.get(rightIdx) > heap.get(largestIdx)) {
      largestIdx = rightIdx;
    }
    
    // If the largest is not the current node, swap and recurse
    if (largestIdx != index) {
      swap(index, largestIdx);
      downheap(largestIdx);
    }
  }
  
  // EFFECT: sort the heap by removing all the items from the heap 
  // and assign it to this sortedHeap
  public void heapSort() {
    int size = this.heap.size();
    for (int i = 0; i < size; i++) {
      removeMax();
    }
  }
  

  // EFFECT: swap two elements in the heap
  private void swap(int i, int j) {
     int temp = heap.get(i);
     heap.set(i, heap.get(j));
     heap.set(j, temp);
  }

}

class ExamplesHeap {

  ArrayList<Integer> list1 = new ArrayList<>(Arrays.asList(1, 2, 3, 4, 5, 6, 7, 8, 9));
  ArrayList<Integer> list2 = new ArrayList<>(Arrays.asList(9, 8, 7, 6, 5, 4, 3, 2, 1));

  void testBuildHeap(Tester t) {
    Heap heap1 = new Heap(list1);
    System.out.println("Source: " + heap1.source);
    System.out.println("buildHeap - upheap");
    heap1.buildHeap();   
    System.out.println(heap1.heap);
    
    Heap heap1a = new Heap(list1);
    heap1a.buildHeapAlt();
    System.out.println("buildHeap - downheap");
    System.out.println(heap1a.heap);

    Heap heap2 = new Heap(list2);
    System.out.println("Source: " + heap2.source);
    System.out.println("buildHeap - upheap");
    heap2.buildHeap();    
    System.out.println(heap2.heap);
    
    Heap heap2a = new Heap(list2);
    heap2a.buildHeapAlt();
    System.out.println("buildHeap - downheap");
    System.out.println(heap2a.heap);
  }

  void testUpheap(Tester t) {
    // upheaping index=1 (2)
    Heap heap1 = new Heap(list1);
    heap1.heap = new ArrayList<>(Arrays.asList(1, 2));
    heap1.upheap(1);
    t.checkExpect(heap1.heap, new ArrayList<>(Arrays.asList(2, 1)));

    // upheaping index=2 (3)
    heap1.heap.add(3);
    heap1.upheap(2);
    t.checkExpect(heap1.heap, new ArrayList<>(Arrays.asList(3, 1, 2)));

    // upheaping index=3 (4)
    heap1.heap.add(4);
    heap1.upheap(3);
    t.checkExpect(heap1.heap, new ArrayList<>(Arrays.asList(4, 3, 2, 1)));

    // upheaping index=4 (5)
    heap1.heap.add(5);
    heap1.upheap(4);
    t.checkExpect(heap1.heap, new ArrayList<>(Arrays.asList(5, 4, 2, 1, 3)));
  }

  void testRemoveMax(Tester t) {
    Heap heap1 = new Heap(list1);
    heap1.buildHeap();
    t.checkExpect(heap1.removeMax(), 9);
    t.checkExpect(heap1.heap, new ArrayList<>(Arrays.asList(8, 7, 6, 4, 3, 2, 5, 1, 9)));
    //t.checkExpect(heap1.sortedHeap, new ArrayList<>(Arrays.asList(9)));

    t.checkExpect(heap1.removeMax(), 8);
    t.checkExpect(heap1.heap, new ArrayList<>(Arrays.asList(7, 4, 6, 1, 3, 2, 5, 8, 9)));
    //t.checkExpect(heap1.sortedHeap, new ArrayList<>(Arrays.asList(9, 8)));

    t.checkExpect(heap1.removeMax(), 7);
    t.checkExpect(heap1.heap, new ArrayList<>(Arrays.asList(6, 4, 5, 1, 3, 2, 7, 8, 9)));
    //t.checkExpect(heap1.sortedHeap, new ArrayList<>(Arrays.asList(9, 8, 7)));

    ArrayList<Integer> lst = new ArrayList<>(Arrays.asList(80, 70, 50, 30, 60, 40, 20, 10, 20, 15, 50));
    Heap heap2 = new Heap(lst);
    heap2.buildHeap();
    t.checkExpect(heap2.removeMax(), 80);
    t.checkExpect(heap2.heap, new ArrayList<>(Arrays.asList(70, 60, 50, 30, 50, 40, 20, 10, 20, 15, 80)));
  }
  
  ArrayList<Integer> testSort(ArrayList<Integer> list) {
    Heap heapTest = new Heap(list);
    heapTest.buildHeap();
    heapTest.heapSort();
    return heapTest.heap;
  }
  
  void testHeapSort(Tester t) {
    // Already Sorted (Ascending)
    t.checkExpect(testSort(list1), new ArrayList<>(Arrays.asList(1, 2, 3, 4, 5, 6, 7, 8, 9)));
    
    // Reverse Sorted (Descending)
    t.checkExpect(testSort(list2), new ArrayList<>(Arrays.asList(1, 2, 3, 4, 5, 6, 7, 8, 9)));
    
    // Simple Unsorted List
    ArrayList<Integer> test1 = new ArrayList<>(Arrays.asList(4, 10, 3, 5, 1));
    t.checkExpect(testSort(test1), new ArrayList<>(Arrays.asList(1, 3, 4, 5, 10)));
    
    // Random Order with Duplicates
    ArrayList<Integer> test4 = new ArrayList<>(Arrays.asList(7, 3, 9, 3, 2, 7));
    t.checkExpect(testSort(test4), new ArrayList<>(Arrays.asList(2, 3, 3, 7, 7, 9)));
    
    // Single Element
    ArrayList<Integer> test5 = new ArrayList<>(Arrays.asList(42));
    t.checkExpect(testSort(test5), test5);
    
    // Empty List
    ArrayList<Integer> test6 = new ArrayList<>();
    t.checkExpect(testSort(test6), test6);
    
    // Negative Numbers
    ArrayList<Integer> test7 = new ArrayList<>(Arrays.asList(-5, 0, 2, -1, -3));
    t.checkExpect(testSort(test7), new ArrayList<>(Arrays.asList(-5, -3, -1, 0, 2)));
    
    // Large Input (Stress Test)
    ArrayList<Integer> test8 = new ArrayList<>();
    for (int i = 0; i < 1000; i++) {
      test8.add((int) (Math.random() * 1000)); // Random numbers 0-999
    }
    System.out.println("Stress Test: ");
    System.out.println(testSort(test8));
  }


}