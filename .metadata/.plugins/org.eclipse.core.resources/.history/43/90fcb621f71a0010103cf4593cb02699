package lecture25iterators;

import java.util.ArrayList;
import java.util.Iterator;

import tester.Tester;

class Util {
  void forEach() {
    ArrayList<Integer> aList = new ArrayList<Integer>();
    aList.add(1); aList.add(2); aList.add(3);
    
    int sum = 0;
    for (Integer i : aList) {
      sum = sum + i;
    }
  }
}

class ArrayListIterator<T> implements Iterator<T> {
  ArrayList<T> items;  // the list of items that this iterator iterates over
  int nextIdx;  // the index of the next item to be returned
  
  // Construct an iterator for a given ArrayList
  ArrayListIterator(ArrayList<T> items) {
    this.items = items;
    this.nextIdx = 0;
  }

  public boolean hasNext() {
    return this.nextIdx < this.items.size();
  }
 
  public T next() {
    T nextItem = this.items.get(nextIdx);
    this.nextIdx = this.nextIdx + 1;
    return nextItem;
  }
 
  public void remove() {
    throw new UnsupportedOperationException("Don't do this!");
  }
}

class ArrayListReverseIterator<T> implements Iterator<T> {
  ArrayList<T> arrayList;  // the list of items that this iterator iterates over
  int currentIndex;  // the index of the next item to be returned
  
  ArrayListReverseIterator(ArrayList<T> arrayList) {
    this.arrayList = arrayList;
    this.currentIndex = arrayList.size() - 1;
  }

  public boolean hasNext() {
    return this.currentIndex >= 0;
  }
 
  public T next() {
    T nextItem = this.arrayList.get(currentIndex);
    this.currentIndex = this.currentIndex - 1;
    return nextItem;
  }
} 


class ArrayListIteratorExamples {
  
  void testSelfMadeForEach(Tester t) {
    ArrayList<String> aList = new ArrayList<String>();
    aList.add("1"); aList.add("2"); aList.add("3");
    
    // not using for each loop
    Iterator<String> aListIterator = new ArrayListIterator<String>(aList);
    String sum = "";
    while (aListIterator.hasNext()) {
      String elem = aListIterator.next();
      sum = sum + elem;
    }  
    t.checkExpect(sum, "123");
    
    
  }
  
  void testReverseIterator(Tester t) {
    ArrayList<String> aList = new ArrayList<String>();
    aList.add("1"); aList.add("2"); aList.add("3");
    Iterator<String> aListReverseIterator = new ArrayListReverseIterator<String>(aList);
    String sum = "";
    while (aListReverseIterator.hasNext()) {
      String elem = aListReverseIterator.next();
      sum = sum + elem;
    }    
    t.checkExpect(sum, "321");
  }
  
}