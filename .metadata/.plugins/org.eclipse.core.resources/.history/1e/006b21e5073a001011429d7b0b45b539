package lecture31dijkstra;

import java.util.ArrayList;
import java.util.List;

class Vertex {
  String name;
  List<Edge> outEdges; // edges from this node
  
  
  Vertex(List<Edge> outEdges, String name) {
    this.name = name;
    this.outEdges = outEdges;  
  }
  
  @Override
  public String toString() {
    return "{" + this.name + "}";
  }
  
  boolean hasPathTo(Vertex dest) {
    return this.hasPathToHelper(dest, new ArrayList<Vertex>());
  }

  private boolean hasPathToHelper(Vertex dest, ArrayList<Vertex> visited) {
    for (Edge e : this.outEdges) {
      // check for cycles
      if (!visited.contains(e.to)) {
        visited.add(e.to);
        
        if (e.to == dest || e.to.hasPathToHelper(dest, visited)) {
          return true;
        }
      }
    }
    return false;
  }
}

class Edge {
  Vertex from;
  Vertex to;
  int weight;
  
  Edge(Vertex from, Vertex to, int weight) {
    this.from = from;
    this.to = to;
    this.weight = weight;
  }
}

class Graph {
  List<Vertex> allVertices;
  
  Graph(List<Vertex> allVertices) {
    this.allVertices = allVertices;
  }
  
  
  // computes the list of vertices that reach the given vertex
  List<Vertex> inEdges(Vertex v) {
    List<Vertex> vertices = new ArrayList<>();
    
    for (Vertex vertex : allVertices) {
      for (Edge outEdge : vertex.outEdges) {
        if (outEdge.to.equals(v)) {
          vertices.add(vertex);
          break;
        }
      }
    }
    return vertices;
  }
  
  boolean hasPathBetween(Vertex from, Vertex to) {
    Deque<Vertex> visited = new Deque<Vertex>();
    Deque<Vertex> worklist = new Deque<Vertex>();
    
    // initialise the worklist by adding the first item
    worklist.addAtHead(from);
    
    while(!worklist.isEmpty()) {
      Vertex vertex = worklist.removeFromHead();
      if (vertex.equals(to)) {
        return true;
      }
      else if (visited.contains(vertex)) {
        // do nothing
      }
      else {
        for (Edge outEdge : vertex.outEdges) {
          worklist.addAtHead(outEdge.to);
        }
        visited.addAtHead(vertex);
      }
    }
    return false;
  }
  
  boolean searchHelp(Vertex from, Vertex to) {
    Deque<Vertex> visited = new Deque<Vertex>();
    PriorityQueue<Vertex> worklist = new PriorityQueue<Vertex>();
    
    // Initialise the worklist with the from vertex
    worklist.add(from, 0);
    
    while (!worklist.isEmpty()) {
      Vertex vertex = worklist.remove();
      
      if (vertex.equals(to)) {
        return true;  // success!
      }
      else if (visited.contains(vertex)) {
        // do nothing
      }
      else {
        // add all the neighbors of next to the worklist for further processing
        for (Edge e : vertex.outEdges) {
          // TODO what should the priorities be?
          worklist.add(e.to);
        }
        // add vertex to visited
        visited.addAtHead(vertex);
      }
    }
    // We haven't found the to vertex, and there are no more to try
    return false;
  }
  
}
